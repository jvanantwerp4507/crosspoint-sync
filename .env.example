# Local dev settings. Copy to .env (gitignored); `npm run dev` loads it.
# Every variable is documented in README.md under Configuration.

DATABASE_PATH=./data/crosspoint.db
PORT=8080

# Enables connectors (encrypts stored credentials). Any 64 hex chars:
#   openssl rand -hex 32
TOKEN_ENC_KEY=

# Outbound connector requests are blocked from reaching private, loopback,
# link-local and cloud-metadata addresses (SSRF protection). Leave this unset on
# any internet-facing install. Set to 1 ONLY on a trusted LAN-only install where
# you intentionally point a connector at a private address (e.g. a local
# Audiobookshelf at 192.168.x.x).
# ALLOW_PRIVATE_CONNECTOR_HOSTS=

